# Leon profile secrets.
# Non-secret profile configuration lives in config.yml.

# LLM provider API keys

# Optional local llama.cpp API key
LEON_LLAMACPP_API_KEY=

# Optional Linux high-performance local provider API key (OpenAI-compatible)
LEON_SGLANG_API_KEY=

# OpenRouter API key
LEON_OPENROUTER_API_KEY=

# Z.AI API key
LEON_ZAI_API_KEY=

# MiniMax API key
LEON_MINIMAX_API_KEY=

# OpenAI API key
LEON_OPENAI_API_KEY=

# Anthropic API key
LEON_ANTHROPIC_API_KEY=

# DeepSeek API key
LEON_DEEPSEEK_API_KEY=

# Moonshot AI API key
LEON_MOONSHOTAI_API_KEY=

# HuggingFace API key
LEON_HUGGINGFACE_API_KEY=

# Cerebras API key
LEON_CEREBRAS_API_KEY=

# Groq API key
LEON_GROQ_API_KEY=

# Celeris API key
LEON_CELERIS_API_KEY=

# Misc

# Token used to authenticate every remote request for this profile
LEON_PROFILE_TOKEN=

# Paul + optional local Letta conversational layer
# Paul structured memory is local and works with these values empty.
PAUL_TIMEZONE=Europe/Paris
PAUL_LETTA_ENABLED=false
PAUL_LETTA_URL=http://127.0.0.1:4500
PAUL_LETTA_TOKEN=
PAUL_LETTA_AGENT_ID=
PAUL_LETTA_MODEL=
PAUL_LETTA_TIMEOUT_MS=20000
